rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'admin@mokkahfabrics.com' || 
        request.auth.token.email == 'ecommercemanagement25@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }
    function isValidString(val, min, max) { return val is string && val.size() >= min && val.size() <= max; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'isAdmin', 'createdAt', 'updatedAt'])
        && isValidString(data.uid, 1, 128)
        && isValidString(data.email, 5, 256)
        && data.isAdmin is bool
        && data.createdAt is number
        && data.updatedAt is number
        && (!data.keys().hasAny(['displayName']) || isValidString(data.displayName, 0, 100));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (incoming().isAdmin == false || request.auth.token.email == 'ecommercemanagement25@gmail.com')
        && incoming().createdAt == request.time.toMillis()
        && incoming().updatedAt == request.time.toMillis();
      allow update: if isSignedIn() && (
        (isAdmin() && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis()) ||
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().isAdmin == existing().isAdmin && incoming().updatedAt == request.time.toMillis())
      );
      allow delete: if isAdmin();
      
      match /addresses/{addressId} {
        function isValidAddress(data) {
          return data.keys().hasAll(['userId', 'name', 'street', 'city', 'zip', 'phone', 'createdAt', 'updatedAt'])
            && isValidString(data.userId, 1, 128)
            && isValidString(data.name, 1, 100)
            && isValidString(data.street, 1, 200)
            && isValidString(data.city, 1, 100)
            && isValidString(data.zip, 1, 20)
            && isValidString(data.phone, 1, 30)
            && data.createdAt is number
            && data.updatedAt is number
            && (!data.keys().hasAny(['isDefault']) || data.isDefault is bool);
        }
        allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(addressId)
          && isValidAddress(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time.toMillis()
          && incoming().updatedAt == request.time.toMillis();
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) 
          && isValidAddress(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time.toMillis();
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
      match /wishlist/{wishlistId} {
        function isValidWishlist(data) {
          return data.keys().hasAll(['productId', 'addedAt'])
            && isValidString(data.productId, 1, 128)
            && data.addedAt is number;
        }
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(wishlistId)
          && isValidWishlist(incoming())
          && exists(/databases/$(database)/documents/products/$(incoming().productId));
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['title', 'price', 'imageUrl', 'stock', 'createdAt', 'updatedAt'])
          && isValidString(data.title, 1, 200)
          && data.price is number
          && isValidString(data.imageUrl, 1, 1000)
          && data.stock is number
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['originalPrice']) || data.originalPrice is number)
          && (!data.keys().hasAny(['hoverImageUrl']) || isValidString(data.hoverImageUrl, 1, 1000))
          && (!data.keys().hasAny(['categoryId']) || isValidString(data.categoryId, 1, 128))
          && (!data.keys().hasAny(['description']) || isValidString(data.description, 0, 5000))
          && (!data.keys().hasAny(['isTrending']) || data.isTrending is bool)
          && (!data.keys().hasAny(['isNew']) || data.isNew is bool);
      }
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == request.time.toMillis() && incoming().updatedAt == request.time.toMillis();
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      function isValidCategory(data) {
        return data.keys().hasAll(['title', 'imageUrl', 'createdAt', 'updatedAt'])
          && isValidString(data.title, 1, 100)
          && isValidString(data.imageUrl, 1, 1000)
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['order']) || data.order is number);
      }
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) && incoming().createdAt == request.time.toMillis() && incoming().updatedAt == request.time.toMillis();
      allow update: if isAdmin() && isValidCategory(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['userId', 'customerName', 'email', 'total', 'status', 'createdAt', 'updatedAt'])
          && isValidString(data.userId, 1, 128)
          && isValidString(data.customerName, 1, 200)
          && isValidString(data.email, 5, 256)
          && data.total is number
          && isValidString(data.status, 1, 50)
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['items']) || data.items is list)
          && (!data.keys().hasAny(['phone']) || isValidString(data.phone, 1, 50))
          && (!data.keys().hasAny(['shippingAddress']) || data.shippingAddress is map)
          && (!data.keys().hasAny(['subtotal']) || data.subtotal is number)
          && (!data.keys().hasAny(['discount']) || data.discount is number)
          && (!data.keys().hasAny(['shippingCost']) || data.shippingCost is number)
          && (!data.keys().hasAny(['paymentMethod']) || isValidString(data.paymentMethod, 1, 50))
          && (!data.keys().hasAny(['paymentStatus']) || isValidString(data.paymentStatus, 1, 50));
      }
      allow get: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time.toMillis()
        && incoming().updatedAt == request.time.toMillis();
      allow update: if isAdmin() && isValidOrder(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.keys().hasAll(['productId', 'userId', 'authorName', 'rating', 'text', 'status', 'createdAt', 'updatedAt'])
          && isValidString(data.productId, 1, 128)
          && isValidString(data.userId, 1, 128)
          && isValidString(data.authorName, 1, 100)
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && isValidString(data.text, 1, 1000)
          && isValidString(data.status, 1, 20)
          && data.createdAt is number
          && data.updatedAt is number;
      }
      allow get: if existing().status == 'approved' || (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if (resource.data.status == 'approved' && resource.data.productId != null) || (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time.toMillis()
        && incoming().updatedAt == request.time.toMillis()
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isAdmin() && isValidReview(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      function isValidBanner(data) {
        return data.keys().hasAll(['imageUrl', 'isActive', 'createdAt', 'updatedAt'])
          && isValidString(data.imageUrl, 1, 1000)
          && data.isActive is bool
          && data.createdAt is number
          && data.updatedAt is number
          && (!data.keys().hasAny(['title']) || isValidString(data.title, 0, 100))
          && (!data.keys().hasAny(['subtitle']) || isValidString(data.subtitle, 0, 200))
          && (!data.keys().hasAny(['buttonText']) || isValidString(data.buttonText, 0, 50))
          && (!data.keys().hasAny(['buttonLink']) || isValidString(data.buttonLink, 0, 500))
          && (!data.keys().hasAny(['order']) || data.order is number);
      }
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(bannerId) && isValidBanner(incoming()) && incoming().createdAt == request.time.toMillis() && incoming().updatedAt == request.time.toMillis();
      allow update: if isAdmin() && isValidBanner(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      function isValidCoupon(data) {
        return data.keys().hasAll(['code', 'discountType', 'discountValue', 'isActive', 'createdAt', 'updatedAt'])
          && isValidString(data.code, 1, 50)
          && isValidString(data.discountType, 1, 20)
          && data.discountValue is number
          && data.isActive is bool
          && data.createdAt is number
          && data.updatedAt is number;
      }
      allow get: if existing().isActive == true || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming()) && incoming().createdAt == request.time.toMillis() && incoming().updatedAt == request.time.toMillis();
      allow update: if isAdmin() && isValidCoupon(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time.toMillis();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      function isValidSettings(data) {
        return data.keys().hasAll(['updatedAt'])
          && data.updatedAt is number
          && (!data.keys().hasAny(['storeName']) || isValidString(data.storeName, 0, 200))
          && (!data.keys().hasAny(['logoText']) || isValidString(data.logoText, 0, 200))
          && (!data.keys().hasAny(['contactEmail']) || isValidString(data.contactEmail, 0, 200))
          && (!data.keys().hasAny(['contactPhone']) || isValidString(data.contactPhone, 0, 200))
          && (!data.keys().hasAny(['address']) || isValidString(data.address, 0, 1000))
          && (!data.keys().hasAny(['announcementText']) || isValidString(data.announcementText, 0, 500))
          && (!data.keys().hasAny(['facebookUrl']) || isValidString(data.facebookUrl, 0, 500))
          && (!data.keys().hasAny(['instagramUrl']) || isValidString(data.instagramUrl, 0, 500))
          && (!data.keys().hasAny(['heroHeadline']) || isValidString(data.heroHeadline, 0, 200))
          && (!data.keys().hasAny(['heroSubheadline']) || isValidString(data.heroSubheadline, 0, 500))
          && (!data.keys().hasAny(['heroImageUrl']) || isValidString(data.heroImageUrl, 0, 1000));
      }
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidSettings(incoming()) && incoming().updatedAt == request.time.toMillis();
      allow delete: if false; 
    }

  }
}
